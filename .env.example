# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
GOOGLE_MAPS_PLATFORM_KEY="MY_GOOGLE_MAPS_PLATFORM_KEY"
VITE_GOOGLE_DRIVE_CLIENT_ID=""
VITE_GOOGLE_DRIVE_ROOT_FOLDER_ID=""
CURP_API_URL=""
CURP_API_KEY=""
JWT_SECRET="change_me_in_production"
ACCESS_TOKEN_TTL_MINUTES="480"
REFRESH_TOKEN_TTL_DAYS="365"
DATABASE_URL=""
REDIS_URL=""
PUBLIC_REGISTRATION_ENABLED="false"
WEBAUTHN_RP_ID="localhost"
WEBAUTHN_ORIGIN="http://localhost:5173"
# true solo cuando tengas dominio HTTPS configurado para passkeys reales.
WEBAUTHN_REQUIRED="false"

# OAuth/OIDC para iniciar sesion o registrar personal con Google/Microsoft.
# Callbacks:
#   Google:    https://TU_DOMINIO/api/auth/oauth/google/callback
#   Microsoft: https://TU_DOMINIO/api/auth/oauth/microsoft/callback
OAUTH_CALLBACK_BASE_URL=""
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
MICROSOFT_OAUTH_CLIENT_ID=""
MICROSOFT_OAUTH_CLIENT_SECRET=""
MICROSOFT_OAUTH_TENANT="common"

# Automatizacion Gmail -> CSV/XLSX -> CRM.
# Usa OAuth2 con refresh token; nunca contraseña directa de Gmail.
# Scope recomendado: https://www.googleapis.com/auth/gmail.readonly
GMAIL_SYNC_CLIENT_ID=""
GMAIL_SYNC_CLIENT_SECRET=""
GMAIL_SYNC_REFRESH_TOKEN=""
GMAIL_SYNC_QUERY="has:attachment (filename:csv OR filename:xlsx OR filename:xls) newer_than:14d"

# Documentos / expedientes
DOCUMENT_STORAGE_DIR="./data/document_storage"
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Twilio para agente de llamadas autónomas
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
TWILIO_WEBHOOK_BASE_URL=""
TWILIO_VOICE="Polly.Mia-Neural"

# Proveedores multi-voz para validaciones
VALIDATION_CALLS_AUTO_ENABLED="false"
VOICE_PROVIDER_DEFAULT="elevenlabs"
VOICE_PROVIDER_FALLBACKS="twilio-basic"
ELEVENLABS_API_KEY=""
ELEVENLABS_AGENT_ID=""
ELEVENLABS_AGENT_PHONE_NUMBER_ID=""
OPENAI_API_KEY=""
OPENAI_REALTIME_MODEL="gpt-realtime"
OPENAI_REALTIME_VOICE="coral"

# Operación productiva
BACKUP_TARGET=""
SENTRY_DSN=""
LOG_DRAIN_URL=""
NPM_AUDIT_REVIEWED=""
VITE_BUNDLE_BUDGET_OK=""

# ─── OCR documental local privado ────────────────────────────────────────────
# Cascada local: Ollama → Tesseract.js. No usa Google Vision ni Gemini para OCR.

# Ollama (primario): API local en la misma maquina/servidor. No requiere API key.
OLLAMA_API_KEY=""
OLLAMA_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="glm-ocr:latest"
OLLAMA_CHAT_MODEL="gemma4:e4b"
OLLAMA_OCR_MODEL="glm-ocr:latest"
OLLAMA_KEEP_ALIVE="30m"
AGENT_AI_TIMEOUT_MS="45000"
OLLAMA_TIMEOUT_MS="30000"
OCR_LLM_TIMEOUT_MS="30000"
OCR_TESSERACT_TIMEOUT_MS="25000"
OCR_MAX_OUTPUT_TOKENS="900"
OCR_OLLAMA_NUM_CTX="4096"
OCR_IMAGE_MAX_SIDE="1600"
OCR_IMAGE_JPEG_QUALITY="82"
OCR_CACHE_TTL_MS="3600000"
OCR_CACHE_MAX_ENTRIES="250"

# Google Gemini (opcional solo para IA empresarial conversacional; no se usa para OCR)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Tesseract.js (fallback): sin API key, corre local. Sin configuración.

# Opcional: forzar proveedor primario ('ollama' | 'tesseract').
OCR_PRIMARY="ollama"

# Estrategia OCR por documento:
# adaptive/quality/fast/local usan proveedores locales en esta versión.
OCR_STRATEGY="local"

# Opcional: sobrescribir orden por tipo de documento. Separar por coma: "ollama,tesseract"
OCR_ORDER_INE=""
OCR_ORDER_COMPROBANTE=""
OCR_ORDER_SIAC=""
