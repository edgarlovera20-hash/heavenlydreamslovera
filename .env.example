# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
GOOGLE_MAPS_PLATFORM_KEY="MY_GOOGLE_MAPS_PLATFORM_KEY"
VITE_GOOGLE_DRIVE_CLIENT_ID=""
VITE_GOOGLE_DRIVE_ROOT_FOLDER_ID=""
CURP_API_URL=""
CURP_API_KEY=""
JWT_SECRET="change_me_in_production"
ACCESS_TOKEN_TTL_MINUTES="480"
REFRESH_TOKEN_TTL_DAYS="365"
DATABASE_URL=""
REDIS_URL=""
PUBLIC_REGISTRATION_ENABLED="false"
WEBAUTHN_RP_ID="localhost"
WEBAUTHN_ORIGIN="http://localhost:5173"
# true solo cuando tengas dominio HTTPS configurado para passkeys reales.
WEBAUTHN_REQUIRED="false"

# OAuth/OIDC para iniciar sesion o registrar personal con Google/Microsoft.
# Callbacks:
#   Google:    https://TU_DOMINIO/api/auth/oauth/google/callback
#   Microsoft: https://TU_DOMINIO/api/auth/oauth/microsoft/callback
OAUTH_CALLBACK_BASE_URL=""
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
MICROSOFT_OAUTH_CLIENT_ID=""
MICROSOFT_OAUTH_CLIENT_SECRET=""
MICROSOFT_OAUTH_TENANT="common"

# Documentos / expedientes
DOCUMENT_STORAGE_DIR="./data/document_storage"
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Google Vision seguro: usa UNA de estas opciones. Nunca subas JSON al repo.
GOOGLE_APPLICATION_CREDENTIALS_JSON=""
GOOGLE_APPLICATION_CREDENTIALS=""

# Twilio para agente de llamadas autónomas
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
TWILIO_WEBHOOK_BASE_URL=""
TWILIO_VOICE="Polly.Mia-Neural"

# Proveedores multi-voz para validaciones
VALIDATION_CALLS_AUTO_ENABLED="false"
VOICE_PROVIDER_DEFAULT="elevenlabs"
VOICE_PROVIDER_FALLBACKS="twilio-basic"
ELEVENLABS_API_KEY=""
ELEVENLABS_AGENT_ID=""
ELEVENLABS_AGENT_PHONE_NUMBER_ID=""
OPENAI_API_KEY=""
OPENAI_REALTIME_MODEL="gpt-realtime"
OPENAI_REALTIME_VOICE="coral"

# Operación productiva
BACKUP_TARGET=""
SENTRY_DSN=""
LOG_DRAIN_URL=""
NPM_AUDIT_REVIEWED=""
VITE_BUNDLE_BUDGET_OK=""

# ─── OCR multi-proveedor con fallback en cascada ─────────────────────────────
# Cascada: Ollama → Google Gemini → Tesseract.js (local)
# Si una falla, automáticamente se intenta la siguiente.

# Ollama (primario): API local en la misma maquina/servidor. No requiere API key.
OLLAMA_API_KEY=""
OLLAMA_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="glm-ocr:latest"
OLLAMA_TIMEOUT_MS="30000"
OCR_LLM_TIMEOUT_MS="30000"
OCR_TESSERACT_TIMEOUT_MS="25000"
OCR_MAX_OUTPUT_TOKENS="900"

# Google Gemini (fallback 1, opcional): https://ai.google.dev/gemini-api
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Tesseract.js (fallback 2): sin API key, corre local. Sin configuración.

# Opcional: forzar proveedor primario ('ollama' | 'gemini' | 'tesseract')
OCR_PRIMARY="ollama"

# Estrategia OCR por documento:
# adaptive = Ollama primero, Gemini segundo
# quality  = máxima precisión primero
# fast     = menor latencia primero
# local    = Ollama/Tesseract primero, APIs como respaldo
OCR_STRATEGY="adaptive"

# Opcional: sobrescribir orden por tipo de documento. Separar por coma.
OCR_ORDER_INE=""
OCR_ORDER_COMPROBANTE=""
OCR_ORDER_SIAC=""
