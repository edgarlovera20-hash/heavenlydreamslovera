# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
GOOGLE_MAPS_PLATFORM_KEY="MY_GOOGLE_MAPS_PLATFORM_KEY"
VITE_GOOGLE_DRIVE_CLIENT_ID=""
VITE_GOOGLE_DRIVE_ROOT_FOLDER_ID=""
JWT_SECRET="change_me_in_production"
DATABASE_URL=""
REDIS_URL=""
WEBAUTHN_RP_ID="localhost"
WEBAUTHN_ORIGIN="http://localhost:5173"
# true solo cuando tengas dominio HTTPS configurado para passkeys reales.
WEBAUTHN_REQUIRED="false"

# ─── OCR multi-proveedor con fallback en cascada ─────────────────────────────
# Cascada: Claude → Google Gemini → OpenAI GPT-4o-mini → Ollama → Tesseract.js (local)
# Si una falla, automáticamente se intenta la siguiente.

# Claude / Anthropic (primario): https://console.anthropic.com/
ANTHROPIC_API_KEY="sk-ant-..."
CLAUDE_MODEL="claude-3-5-sonnet-latest"

# Google Gemini (fallback 1): https://ai.google.dev/gemini-api
GEMINI_API_KEY="AIzaSy..."

# OpenAI GPT-4o-mini (fallback 2): https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-..."

# Ollama (fallback 3): API de Ollama local o remota
OLLAMA_API_KEY="tu_ollama_api_key"
OLLAMA_URL="http://localhost:11434"

# Tesseract.js (fallback 4): sin API key, corre local. Sin configuración.

# Opcional: forzar proveedor primario ('claude' | 'gemini' | 'openai' | 'ollama' | 'tesseract')
OCR_PRIMARY="claude"
