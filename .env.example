# ─── DATABASE ─────────────────────────────────────────────────
DATABASE_URL=postgresql://hd_user:hd_secret@localhost:5432/heavenlydreams
POSTGRES_DB=heavenlydreams
POSTGRES_USER=hd_user
POSTGRES_PASSWORD=hd_secret

# ─── REDIS ────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_secret

# ─── AUTH ─────────────────────────────────────────────────────
JWT_SECRET=change_me_super_secret_jwt_key_minimum_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_key_minimum_32_chars
JWT_EXPIRES_IN=15m

# ─── SERVICES ─────────────────────────────────────────────────
API_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3001
INTERNAL_API_KEY=change_me_internal_service_key

WA_SERVICE_URL=http://localhost:4001
OCR_SERVICE_URL=http://localhost:4002
AI_SERVICE_URL=http://localhost:4003

# ─── AI / OLLAMA ──────────────────────────────────────────────
OLLAMA_URL=http://localhost:11434
PHI3_MODEL=phi3
MISTRAL_MODEL=mistral:7b

# ─── OCR PROVIDERS ────────────────────────────────────────────
# Cascada: Gemini → OpenAI → Tesseract (local)
GEMINI_API_KEY=AIzaSy...
OPENAI_API_KEY=sk-...
# OCR_PRIMARY=gemini

# ─── FRONTEND ─────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_WS_URL=http://localhost:3000

# ─── PHONE/EMAIL VALIDATION ───────────────────────────────────
# NUMVERIFY_API_KEY=your_key_here
# ZEROBOUNCE_API_KEY=your_key_here

# ─── PORTS ────────────────────────────────────────────────────
PORT=3000
WA_SERVICE_PORT=4001
OCR_SERVICE_PORT=4002
AI_SERVICE_PORT=4003

# ─── LEGACY (keep for reference) ──────────────────────────────
APP_URL=MY_APP_URL
GOOGLE_MAPS_PLATFORM_KEY=MY_GOOGLE_MAPS_PLATFORM_KEY
