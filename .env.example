# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
GOOGLE_MAPS_PLATFORM_KEY="MY_GOOGLE_MAPS_PLATFORM_KEY"

# ─── OCR multi-proveedor con fallback en cascada ─────────────────────────────
# Cascada: Google Gemini 1.5 Pro → OpenAI GPT-4o-mini → Tesseract.js (local)
# Si una falla, automáticamente se intenta la siguiente.

# Google Gemini 1.5 Pro (primario): https://ai.google.dev/gemini-api
GEMINI_API_KEY="AIzaSy..."

# OpenAI GPT-4o-mini (fallback 1): https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-..."

# Tesseract.js (fallback 2): sin API key, corre local. Sin configuración.

# Opcional: forzar proveedor primario ('gemini' | 'openai' | 'tesseract')
# OCR_PRIMARY="gemini"
