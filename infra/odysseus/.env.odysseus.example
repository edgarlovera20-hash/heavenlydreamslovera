# Odysseus — Variables de entorno para Heavenly Dreams
# Copiar a .env.odysseus y rellenar los valores reales.
# NUNCA subir .env.odysseus a GitHub.

APP_BIND=127.0.0.1
APP_PORT=7000

AUTH_ENABLED=true
LOCALHOST_BYPASS=false
SECURE_COOKIES=true

ODYSSEUS_ADMIN_USER=admin_heavenly
ODYSSEUS_ADMIN_PASSWORD=CAMBIAR_PASSWORD_SEGURA_32_CHARS

DATABASE_URL=sqlite:///./data/app.db

# LLM — Ollama local en la misma red
LLM_HOST=host.docker.internal
LLM_HOSTS=
OPENAI_API_KEY=

# ChromaDB — vector store (no exponer a internet)
CHROMADB_HOST=chromadb
CHROMADB_PORT=8000

# SearXNG — búsqueda interna (no exponer)
SEARXNG_INSTANCE=

# Límites de subida
ODYSSEUS_CHAT_UPLOAD_MAX_BYTES=52428800
ODYSSEUS_PERSONAL_UPLOAD_MAX_BYTES=52428800
ODYSSEUS_MEMORY_IMPORT_MAX_BYTES=52428800
ODYSSEUS_EMAIL_COMPOSE_UPLOAD_MAX_BYTES=26214400
