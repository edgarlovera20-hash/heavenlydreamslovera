{
  "name": "heavenly-dreams-platform",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "dev:api": "turbo run dev --filter=@heavenly/api",
    "dev:web": "turbo run dev --filter=@heavenly/web",
    "dev:whatsapp": "turbo run dev --filter=@heavenly/whatsapp-service",
    "dev:worker": "turbo run dev --filter=@heavenly/worker-service",
    "db:generate": "turbo run db:generate --filter=@heavenly/database",
    "db:migrate": "turbo run db:migrate --filter=@heavenly/database",
    "db:studio": "turbo run db:studio --filter=@heavenly/database",
    "docker:up": "docker-compose -f infrastructure/docker/docker-compose.yml up -d",
    "docker:down": "docker-compose -f infrastructure/docker/docker-compose.yml down",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@10.0.0"
}
