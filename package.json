{
  "name": "heavenly-dreams-enterprise",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@11.12.1",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "NODE_ENV=production tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist .turbo",
    "lint": "tsc --noEmit",
    "enterprise:check": "node scripts/enterprise-check.mjs",
    "preprod:check": "node scripts/preprod-real-data-check.mjs",
    "backup:sqlite": "node scripts/backup-db.mjs",
    "import:morosos": "node scripts/import-morosos-xlsx.mjs",
    "test:api": "node scripts/api-smoke.mjs",
    "test": "npm run lint && npm run enterprise:check && npm run preprod:check && npm run test:api",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "turbo:build": "turbo run build",
    "turbo:lint": "turbo run lint",
    "turbo:dev": "turbo run dev --parallel"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@google/generative-ai": "^0.20.0",
    "@gsap/react": "^2.1.2",
    "@sentry/react": "^8.55.2",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "@whiskeysockets/baileys": "^7.0.0-rc13",
    "ai": "^6.0.193",
    "better-sqlite3": "^12.10.0",
    "bullmq": "^5.77.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "compression": "^1.8.1",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "gsap": "^3.15.0",
    "heic2any": "^0.0.4",
    "html2canvas": "^1.4.1",
    "idb-keyval": "^6.2.4",
    "ioredis": "^5.10.1",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "maplibre-gl": "^5.24.0",
    "motion": "^12.38.0",
    "pg": "^8.21.0",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-is": "^19.2.7",
    "recharts": "^3.8.1",
    "sharp": "^0.34.5",
    "simple-icons": "^16.23.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tesseract.js": "^5.1.1",
    "tsx": "^4.22.3",
    "vite": "^6.2.0",
    "ws": "^8.21.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@sentry/node": "^8.55.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.19.19",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^2.0.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "turbo": "^2.5.8",
    "typescript": "~5.8.3",
    "vite": "^6.2.0",
    "vitest": "^2.0.0"
  }
}
