rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // -------------------------------------------------------------------------
    // GLOBALS & HELPERS
    // -------------------------------------------------------------------------
    
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Role lookups
    function getUserData(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function hasRole(uid, role) {
      return isSignedIn() && getUserData(uid).role == role;
    }

    function isAdmin() {
      return hasRole(request.auth.uid, 'GERENTE') || request.auth.token.email == 'edgarlovera20@gmail.com';
    }

    function isSupervisor() {
      return hasRole(request.auth.uid, 'SUPERVISOR') || isAdmin();
    }

    // -------------------------------------------------------------------------
    // ENTITY VALIDATIONS
    // -------------------------------------------------------------------------

    function isValidUser(data) {
      return data.keys().hasAll(['nombre', 'apellidoPaterno', 'email', 'role']) &&
             data.nombre is string && data.nombre.size() > 0 && data.nombre.size() <= 100 &&
             data.apellidoPaterno is string && data.apellidoPaterno.size() <= 100 &&
             data.email == request.auth.token.email &&
             data.role in ['GERENTE', 'SUPERVISOR', 'ASESOR'];
    }

    function isValidSale(data) {
      return data.keys().hasAll(['folio', 'nombres', 'apellidoPaterno', 'packageId', 'rentaMensual', 'asesorId']) &&
             data.folio is string && data.folio.size() <= 50 &&
             data.nombres is string && data.nombres.size() <= 100 &&
             data.rentaMensual is number && data.rentaMensual >= 0 &&
             data.asesorId == request.auth.uid;
    }

    // -------------------------------------------------------------------------
    // COLLECTION MATCHES
    // -------------------------------------------------------------------------

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create: if isSignedIn() && userId == request.auth.uid && isValidUser(incoming()) && (incoming().role == 'ASESOR' || isAdmin());
      allow update: if isSignedIn() && userId == request.auth.uid && (
        (incoming().diff(existing()).affectedKeys().hasOnly(['nombre', 'apellidoPaterno', 'apellidoMaterno', 'telefono', 'puesto'])) ||
        isAdmin()
      );
    }

    match /sales/{saleId} {
      allow get: if isSignedIn() && (existing().asesorId == request.auth.uid || isSupervisor());
      allow list: if isSignedIn() && (resource.data.asesorId == request.auth.uid || isSupervisor());
      allow create: if isEmailVerified() && isValidSale(incoming()) && isValidId(saleId);
      allow update: if isSignedIn() && (
        (existing().asesorId == request.auth.uid && existing().status != 'PROCESADO' && incoming().diff(existing()).affectedKeys().hasOnly(['nombres', 'apellidoPaterno', 'telefonoTitular', 'calle', 'status'])) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /tickets/{ticketId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (existing().agenteId == request.auth.uid || isAdmin());
    }

    match /apiKeys/{keyId} {
      allow read, write: if isAdmin();
    }
  }
}
